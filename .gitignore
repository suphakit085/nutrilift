# Python
__pycache__/
*.egg-info/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
.env.local
*.env
!.env.example

# Node / Next.js
node_modules/
.next/
tsconfig.tsbuildinfo
out/
.vercel/

# Data & reports
eval/reports/*
!eval/reports/.gitkeep
# Keep the written reports. They are the before/after evidence the thesis quotes
# directly, and an LLM run cannot be reproduced byte-for-byte - once a "before"
# state is lost it cannot be regenerated. The raw *_answers.csv stay out (~5 MB),
# and *_expert_key.csv must never be committed: it maps the blinded A/B columns
# back to rag/norag, so publishing it would destroy the blinding.
!eval/reports/*.md
# Source documents and anything derived from them belong to their publishers
# (INMU, กรมอนามัย, journals). Fetch them locally; do not redistribute here.
knowledge/sources/*
!knowledge/sources/.gitkeep

# Design canvas: the .dc.html artboards are the source and are tracked, but the
# seeded page bundles a ~2.5 MB editor payload and is regenerated on every edit.
design/*.html
!design/*.dc.html

# Local tooling state
.claude/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# SUS answers from real participants (open-ended text) - keep local
eval/sus/responses*.csv
