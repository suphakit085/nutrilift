# ---- Gemini ----
GEMINI_API_KEY=AIza...
LLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536

# ---- Database ----
DATABASE_URL=postgresql+psycopg://nutrition:nutrition@localhost:5432/nutrition

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- App ----
CORS_ORIGINS=http://localhost:3000
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.63
RETRIEVAL_RELATIVE_WINDOW=0.10
RETRIEVAL_HYBRID=true
RETRIEVAL_CANDIDATE_MULTIPLIER=3
HISTORY_TURNS=8

# ---- Rate limiting ----
RATE_LIMIT_CHAT_PER_HOUR=20
RATE_LIMIT_CHAT_PER_DAY=60
RATE_LIMIT_CHAT_GLOBAL_PER_DAY=1500
RATE_LIMIT_AUTH_PER_15MIN=10
