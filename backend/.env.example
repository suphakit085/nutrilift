# ---- Gemini ----
GEMINI_API_KEY=AIza...
LLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536

# ---- Database ----
DATABASE_URL=postgresql+psycopg://nutrition:nutrition@localhost:5432/nutrition

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- App ----
# Set to "production" on the deployed host. In production the server refuses
# to start on a placeholder JWT_SECRET / GEMINI_API_KEY instead of only
# warning. Render (RENDER=...) and Railway (RAILWAY_*) are detected
# automatically even if this is left unset.
ENVIRONMENT=development
# Comma-separated. Trailing slashes / uppercase are tolerated and normalised.
CORS_ORIGINS=http://localhost:3000
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.63
RETRIEVAL_RELATIVE_WINDOW=0.10
# Keyword hit + best dense score under this = refused without a model call
# (chat.is_clearly_out_of_scope). Re-check with eval/calibrate_threshold.py --verbose
# whenever the knowledge base changes.
RETRIEVAL_OUT_OF_SCOPE_SCORE=0.66
RETRIEVAL_HYBRID=true
RETRIEVAL_CANDIDATE_MULTIPLIER=3
HISTORY_TURNS=8

# ---- Rate limiting ----
RATE_LIMIT_CHAT_PER_HOUR=20
RATE_LIMIT_CHAT_PER_DAY=60
RATE_LIMIT_CHAT_GLOBAL_PER_DAY=1500
# Login+register attempts per IP (a classroom shares one NAT, so keep this loose)
RATE_LIMIT_AUTH_PER_15MIN=60
# Login attempts per email address - the actual password-guessing guard
RATE_LIMIT_LOGIN_PER_EMAIL_PER_15MIN=10
