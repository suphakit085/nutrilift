{
  "name": "nutrilift-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts tests/*.test.mjs",
    "test:diary-ui": "node ../eval/uat_browser/run_diary_requests.mjs",
    "test:meal-ui": "node ../eval/uat_browser/run_meal_cards.mjs",
    "test:account-ui": "node ../eval/uat_browser/run_account_flows.mjs",
    "test:dietary-ui": "node ../eval/uat_browser/run_dietary_preferences.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "file:../../../tools/next-eslint-glob"
    }
  }
}
